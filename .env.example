# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings → Environment Variables (Production and Preview).
#
# Both values are public by design. Row-level security in Supabase protects the data.
# Without them the app runs without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
